# Copier en .env et adapter si besoin.
# URL du serveur de tracking MLflow (local par défaut).
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Hosts acceptés par le serveur MLflow du docker-compose (MLflow 3.x).
# Sur l'EC2, ajouter l'IP ou le DNS public pour ouvrir l'UI depuis un navigateur :
# MLFLOW_SERVER_ALLOWED_HOSTS=mlflow,mlflow:*,localhost,localhost:*,127.0.0.1,127.0.0.1:*,<ip-publique>:5000
